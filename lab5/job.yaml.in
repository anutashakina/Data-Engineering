apiVersion: batch/v1
kind: Job
metadata:
  name: $name
spec:
  completions: $parts
  parallelism: $parts
  completionMode: $completion_mode
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: pairs
          image: dz5-pairs-$image:local
          imagePullPolicy: Never
          args: ["$mode"]
          env:
            - {name: RUN_ID, value: "$run_id"}
            - {name: AWS_DEFAULT_REGION, value: us-east-1}
          envFrom:
            - secretRef: {name: rustfs-login, optional: true}
          resources:
            requests: {cpu: 100m, memory: $request}
            limits: {cpu: "1", memory: $limit}
