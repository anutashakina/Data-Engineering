apiVersion: v1
kind: Pod
metadata: {name: $name}
spec:
  priorityClassName: $priority
  nodeSelector: {kubernetes.io/hostname: "$hostname"}
  terminationGracePeriodSeconds: 1
  restartPolicy: Never
  containers:
    - name: hold
      image: dz5-pairs-worker:local
      imagePullPolicy: Never
      command: ["python", "-c", "import time; time.sleep(900)"]
      resources:
        requests: {cpu: "$cpu", memory: 16Mi}
        limits: {cpu: "$cpu", memory: 32Mi}
